local function device_meta(s:*T.State,a:pointer):int32 <cimport 'drift_rng_device_meta',cinclude '"profile.h"'> end
local function device_result(s:*T.State,i:*[0]*T.Object,d:*[0]*T.Object) <cimport 'drift_rng_device_result',cinclude '"profile.h"'> end
