local function WdfDriverCreate(o:*T.Object,registry:pointer,attrs:pointer,c:pointer,result:*[0]*T.Object):int32 <cexport,codename 'WdfDriverCreate'>
 local s=T.owner(o,7)
 if s==nilptr or s.phase~=1 or s.configured~=0 or driver_meta(s,c,attrs)==0 then return T.INVALID end
 s.configured=1;if result~=nilptr then result[0]=T.object(s,1) end;return 0
end
local function WdfDeviceInitSetPnpPowerEventCallbacks(o:*T.Object,c:pointer) <cexport,codename 'WdfDeviceInitSetPnpPowerEventCallbacks'>
 local s=T.owner(o,6);if s==nilptr then return end
 if s.configured~=1 or power_meta(s,c)==0 then T.fail(s,T.INVALID);return end
 s.configured=5
end
local function WdfDeviceInitSetIoType(o:*T.Object,t:uint32) <cexport,codename 'WdfDeviceInitSetIoType'>
 local s=T.owner(o,6);if s==nilptr then return end
 if s.configured~=5 or t~=3 then T.fail(s,T.INVALID);return end
 io_type(s,t)
end
local function WdfDeviceCreate(i:*[0]*T.Object,a:pointer,out:*[0]*T.Object):int32 <cexport,codename 'WdfDeviceCreate'>
 if i==nilptr or out==nilptr then return T.INVALID end
 local s=T.owner(i[0],6)
 if s==nilptr or s.configured~=5 or device_meta(s,a)==0 then return T.INVALID end
 device_result(s,i,out);s.configured=7;return 0
end
local function WdfInterruptCreate(d:*T.Object,c:pointer,a:pointer,out:*[0]*T.Object):int32 <cexport,codename 'WdfInterruptCreate'>
 local s=T.owner(d,2)
 if s==nilptr or s.configured~=7 or a~=nilptr or out==nilptr or irq_meta(s,c)==0 then return T.INVALID end
 s.configured=15;out[0]=T.object(s,4);return 0
end
local function WdfSpinLockCreate(a:pointer,out:*[0]*T.Object):int32 <cexport,codename 'WdfSpinLockCreate'>
 local s=T.current()
 if s==nilptr or s.configured~=15 or out==nilptr or lock_meta(s,a)==0 then return T.INVALID end
 s.configured=31;out[0]=T.object(s,5);return 0
end
local function WdfDeviceCreateDeviceInterface(d:*T.Object,g:pointer,r:pointer):int32 <cexport,codename 'WdfDeviceCreateDeviceInterface'>
 local s=T.owner(d,2)
 if s==nilptr or s.configured~=31 or r~=nilptr or iface_meta(s,g)==0 then return T.INVALID end
 s.configured=63;return 0
end
local function WdfIoQueueCreate(d:*T.Object,c:pointer,a:pointer,out:*[0]*T.Object):int32 <cexport,codename 'WdfIoQueueCreate'>
 local s=T.owner(d,2)
 if s==nilptr or s.configured~=63 or a~=nilptr or out==nilptr or queue_meta(s,c)==0 then return T.INVALID end
 s.configured=127;out[0]=T.object(s,3);return 0
end
local function WdfDeviceConfigureRequestDispatching(d:*T.Object,q:*T.Object,t:uint32):int32 <cexport,codename 'WdfDeviceConfigureRequestDispatching'>
 local s=T.owner(d,2)
 if s==nilptr or s.configured~=127 or q~=T.object(s,3) or t~=3 then return T.INVALID end
 s.configured=255;return 0
end
local function WdfDriverWdmGetDriverObject(d:*T.Object):*T.Object <cexport,codename 'WdfDriverWdmGetDriverObject'>
 local s=T.owner(d,1);if s==nilptr then return nilptr end;return T.object(s,7)
end
local function WdfIoQueueGetDevice(q:*T.Object):*T.Object <cexport,codename 'WdfIoQueueGetDevice'>
