local T=require 'runtime_types'
local function driver_meta(s:*T.State,c:pointer,a:pointer):int32 <cimport 'drift_rng_driver_meta',cinclude '"profile.h"'> end
local function power_meta(s:*T.State,c:pointer):int32 <cimport 'drift_rng_power_meta',cinclude '"profile.h"'> end
