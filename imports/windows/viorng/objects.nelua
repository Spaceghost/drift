end
local function WdfRequestGetIoQueue(r:*T.Request):*T.Object <cexport,codename 'WdfRequestGetIoQueue'>
 if r==nilptr or r.owner==nilptr or r.phase~=2 or r.owner.active~=r then return nilptr end
 return T.object(r.owner,3)
end
local function drift_win_rng_get_context(o:*T.Object):pointer <cexport,codename 'drift_win_rng_get_context'>
 local s=T.owner(o,2);if s==nilptr or (s.configured&2)==0 then return nilptr end;return context(s)
end
