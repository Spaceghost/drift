-- Closed WDF/Virtio personality for the pinned unchanged Windows RNG source.
-- SPDX-License-Identifier: MIT
## pragmas.nogc=true
## pragmas.noentrypoint=true
## pragmas.nochecks=true
## pragmas.nocstaticassert=true
## pragmas.unitname='drift_windows_viorng'
