local function drift_lx_vrng_name(out:cstring,format:cstring,index:cint):cint <cexport,codename 'drift_lx_vrng_name'>
  local s=current();local expected:cstring='virtio_rng.%d';local prefix:cstring='virtio_rng.'
  if s==nilptr or out==nilptr or format==nilptr or index<0 or index>15 then fail(s,-22);return -22 end
  local o=(@*[0]cchar)(out);local f=(@*[0]cchar)(format);local e=(@*[0]cchar)(expected);local p=(@*[0]cchar)(prefix)
  for i:uint32=0,13 do if f[i]~=e[i] then fail(s,-22);return -22 end end
  for i:uint32=0,<11 do o[i]=p[i] end
  if index>=10 then o[11]=cchar(49);o[12]=cchar(48+index-10);o[13]=cchar(0);return 13 end
  o[11]=cchar(48+index);o[12]=cchar(0);return 12
end
local function drift_lx_vrng_memcpy(dst:pointer,src:pointer,n:csize):pointer <cexport,codename 'drift_lx_vrng_memcpy'>
  local s=current()
  if s==nilptr or dst==nilptr or src==nilptr or n>4096 then fail(s,-22);return nilptr end
  local da=(@csize)(dst);local sa=(@csize)(src)
