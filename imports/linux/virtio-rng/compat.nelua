  local text=(@*[0]cchar)(name)
  if text[0]~=cchar(105) or text[1]~=cchar(110) or text[2]~=cchar(112) or text[3]~=cchar(117) or text[4]~=cchar(116) or text[5]~=cchar(0) then fail(s,-22);return (@*VQ)(-22) end
  local n=capacity(s)
  if n==0 or n>4096 or hw.alloc(bus(s),n,4096,&s.payload)~=0 then fail(s,-12);return (@*VQ)(-12) end
  if s.payload.data==nilptr or s.payload.size<n or s.payload.address>0xffffffffffffffff_u64-n then fail(s,-12);return (@*VQ)(-12) end
  clear(s.payload.data,n);s.queue_created=1
