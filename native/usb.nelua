    value=rd(d,portreg)
  end
  d.speed=(value>>10)&15
  if (value&3)~=3 or d.speed==0 or d.speed>3 then return -95 end
  d.port=port
  return enumerate(d)
end
local function drift_usb_attach(d: *USB,port: uint32): int32 <cexport,codename 'drift_usb_attach'> return attach_root(d,port,0) end
local function drift_usb_attach_config(d: *USB,port: uint32,index: uint32): int32 <cexport,codename 'drift_usb_attach_config'> return attach_root(d,port,index) end
local function drift_usb_hid(d: *USB,report: *[0]uint8,capacity: uint32,received: *uint32): int32 <cexport,codename 'drift_usb_hid'>
  if not ready(d) or (d.kind~=1 and d.kind~=2) then return -22 end
  local n: uint32=8
  if d.kind==2 then n=3 end
  if capacity<n then return -22 end
  local result=drift_usb_transfer(d,uint8(d.endpoint_in),report,n,received)
  if result==0 and $received~=n then return -5 end
  return result
end
local function be32(p: *[0]uint8,o: uint32): uint32
  return uint32(p[o])<<24|uint32(p[o+1])<<16|uint32(p[o+2])<<8|uint32(p[o+3])
end
local function big32(p: *[0]uint8,o: uint32,v: uint32)
  for i: uint32=0,3 do p[o+i]=uint8((v>>((3-i)*8))&255) end
end
local function storage_reset(d: *USB): int32
  local n: uint32=0
  local e=drift_usb_control(d,0x21,0xff,0,uint16(d.interface_number),nilptr,0,&n)
  if e~=0 then return e end
  e=drift_usb_control(d,2,1,0,uint16(d.endpoint_in),nilptr,0,&n)
  if e~=0 then return e end
  e=drift_usb_control(d,2,1,0,uint16(d.endpoint_out),nilptr,0,&n)
  if e~=0 then return e end
  e=drift_usb_recover(d,uint8(d.endpoint_in))
  if e~=0 then return e end
  return drift_usb_recover(d,uint8(d.endpoint_out))
end
local function bot(d: *USB,command_bytes: *[0]uint8,command_length: uint32,data: *[0]uint8,length: uint32,input: boolean): int32
  if not ready(d) or d.kind~=3 or command_length==0 or command_length>16 or length>16384 then return -22 end
  local wrapper: [31]uint8
  local status: [13]uint8
  for i: uint32=0,30 do wrapper[i]=0 end
  d.tag=d.tag+1
  if d.tag==0 then d.tag=1 end
  put(&wrapper[0],0,0x43425355); put(&wrapper[0],4,d.tag); put(&wrapper[0],8,length)
  if input then wrapper[12]=128 end
  wrapper[14]=uint8(command_length)
  for i: uint32=0,<command_length do wrapper[15+i]=command_bytes[i] end
  local got: uint32=0
  local result=drift_usb_transfer(d,uint8(d.endpoint_out),&wrapper[0],31,&got)
  if result~=0 or got~=31 then if d.state==1 then storage_reset(d) end; return -5 end
  if length>0 then
    local endpoint=d.endpoint_out
    if input then endpoint=d.endpoint_in end
    result=drift_usb_transfer(d,uint8(endpoint),data,length,&got)
    if result~=0 then if d.state==1 then storage_reset(d) end; return result end
    if got~=length then storage_reset(d); return -5 end
  end
  result=drift_usb_transfer(d,uint8(d.endpoint_in),&status[0],13,&got)
  if result~=0 then if d.state==1 then storage_reset(d) end; return result end
  if got~=13 or get(&status[0],0)~=0x53425355 or get(&status[0],4)~=d.tag or get(&status[0],8)~=0 or status[12]>1 then
    storage_reset(d); return -5
  end
  if status[12]~=0 then return -5 end
  return 0
end
local function drift_usb_storage_info(d: *USB,blocks: *uint64,sector_size: *uint32): int32 <cexport,codename 'drift_usb_storage_info'>
  if not ready(d) or blocks==nilptr or sector_size==nilptr or d.kind~=3 then return -22 end
  local command_bytes: [10]uint8
  local reply: [18]uint8
  for i: uint32=0,9 do command_bytes[i]=0 end
  command_bytes[0]=0x25
  local result=bot(d,&command_bytes[0],10,&reply[0],8,true)
  if result~=0 and d.state==1 then
    command_bytes[0]=3; command_bytes[4]=18
    bot(d,&command_bytes[0],6,&reply[0],18,true)
    command_bytes[0]=0x25; command_bytes[4]=0
    result=bot(d,&command_bytes[0],10,&reply[0],8,true)
  end
  if result~=0 then return result end
  local last=be32(&reply[0],0); local bytes=be32(&reply[0],4)
  if last==0xffffffff or (bytes~=512 and bytes~=4096) then return -95 end
  d.blocks=uint64(last)+1; d.sector_size=bytes
  $blocks=d.blocks; $sector_size=bytes
  return 0
end
local function storage_io(d: *USB,lba: uint64,count: uint32,data: *[0]uint8,write: boolean): int32
  if not ready(d) or d.kind~=3 or d.sector_size==0 or data==nilptr or count==0 or count>16384//d.sector_size or lba>=d.blocks or uint64(count)>d.blocks-lba or lba>0xffffffff then return -22 end
  local command_bytes: [10]uint8
  for i: uint32=0,9 do command_bytes[i]=0 end
  command_bytes[0]=0x28
  if write then command_bytes[0]=0x2a end
  big32(&command_bytes[0],2,uint32(lba)); command_bytes[7]=uint8(count>>8); command_bytes[8]=uint8(count&255)
  return bot(d,&command_bytes[0],10,data,count*d.sector_size,not write)
end
local function drift_usb_storage_read(d: *USB,lba: uint64,count: uint32,data: *[0]uint8): int32 <cexport,codename 'drift_usb_storage_read'> return storage_io(d,lba,count,data,false) end
local function drift_usb_storage_write(d: *USB,lba: uint64,count: uint32,data: *[0]uint8): int32 <cexport,codename 'drift_usb_storage_write'> return storage_io(d,lba,count,data,true) end
local function drift_usb_storage_flush(d: *USB): int32 <cexport,codename 'drift_usb_storage_flush'>
  local command_bytes: [10]uint8
  for i: uint32=0,9 do command_bytes[i]=0 end
  command_bytes[0]=0x35
  return bot(d,&command_bytes[0],10,nilptr,0,false)
end
-- Change an interface without handing endpoint contexts to the OS. Only
-- bulk/interrupt alternate settings present in the device descriptor are used.
local function drift_usb_set_interface(d: *USB,number: uint8,alternate: uint8): int32 <cexport,codename 'drift_usb_set_interface'>
  if not ready(d) then return -22 end
  for i: uint32=2,31 do if d.pending_count[i]~=0 then return -16 end end
  local found: boolean=false
  local current: boolean=false
  local target: boolean=false
  local old_mask: uint32=0
  local new_mask: uint32=0
  local at: uint32=9
  -- Retire endpoint windows belonging to any alternate of this interface.
  while at<d.total_config do
    if d.total_config-at<2 then return -5 end
    local n=uint32(d.config[at]); local kind=uint32(d.config[at+1])
    if n<2 or n>d.total_config-at then return -5 end
    if kind==4 then
      if n<9 then return -5 end
      current=d.config[at+2]==number
      target=current and d.config[at+3]==alternate
      if target then found=true end
    elseif kind==5 and current then
      if n<7 then return -5 end
      local address=uint32(d.config[at+2]); local ep=(address&15)*2
      if (address&128)~=0 then ep=ep+1 end
      if ep<2 or ep>31 then return -95 end
      if d.ring_offset[ep]~=0 then old_mask=old_mask|(1_u32<<ep) end
    end
    at=at+n
  end
  if not found then return -95 end
  clear(d,16384,4096)
  sync(d,d.device_context,d.context_size,2)
  for i: uint32=0,<d.context_size do d.arena.data[16384+d.context_size+i]=d.arena.data[d.device_context+i] end
  -- Reuse a retired ring only after Configure Endpoint has dropped it. No
  -- transfer is outstanding, so writing these idle software rings is safe.
  for ep: uint32=2,31 do
    if (old_mask&(1_u32<<ep))~=0 then d.ring_offset[ep]=0 end
  end
  current=false; at=9
  while at<d.total_config do
    local n=uint32(d.config[at]); local kind=uint32(d.config[at+1])
    if kind==4 then current=d.config[at+2]==number and d.config[at+3]==alternate
    elseif kind==5 and current then
      local address=uint32(d.config[at+2]); local endpoint=(address&15)*2
      local input=(address&128)~=0
      if input then endpoint=endpoint+1 end
      local attributes=uint32(d.config[at+3])&3
      local packet=little16(&d.config[0],at+4)
      if (address&0x70)~=0 or d.ring_offset[endpoint]~=0 or packet==0 or packet>1024 or (attributes~=2 and attributes~=3) then return poison(d,-95) end
      local base: uint32=0
      for i: uint32=0,7 do
        local candidate=28672+i*4096
        local used: boolean=false
        for ep: uint32=2,31 do if d.ring_offset[ep]==candidate then used=true end end
        if not used then base=candidate; break end
      end
      if base==0 then return poison(d,-95) end
      d.ring_offset[endpoint]=base; d.ring_index[endpoint]=0; d.ring_cycle[endpoint]=1
      clear(d,base,4096); sync(d,base,4096,1)
      local interval: uint32=0
      if attributes==3 then
        local raw=uint32(d.config[at+6]); if raw==0 then return poison(d,-95) end
        if d.speed==3 then if raw>16 then return poison(d,-95) end; interval=raw-1
        else interval=3; local v: uint32=1; while v<raw do v=v<<1; interval=interval+1 end end
      end
      local etype=attributes; if input then etype=etype+4 end
      local context=16384+(endpoint+1)*d.context_size
      put(d.arena.data,context,interval<<16)
      put(d.arena.data,context+4,3<<1|etype<<3|packet<<16)
      put64(d.arena.data,context+8,d.arena.address+base|1)
      local metrics=packet
      if attributes==3 then metrics=metrics|(packet<<16) end
      put(d.arena.data,context+16,metrics)
      new_mask=new_mask|(1_u32<<endpoint)
    end
    at=at+n
  end
  local highest: uint32=1
  for ep: uint32=2,31 do if d.ring_offset[ep]~=0 then highest=ep end end
  local slotflags=get(d.arena.data,16384+d.context_size)
  put(d.arena.data,16384+d.context_size,(slotflags&0x07ffffff)|(highest<<27))
  put(d.arena.data,16384,old_mask); put(d.arena.data,16388,new_mask|1)
  sync(d,16384,4096,1)
  local result=command(d,d.arena.address+16384,12<<10|d.slot<<24)
  if result~=0 then return result end
  local got: uint32=0
  return drift_usb_control(d,1,11,uint16(alternate),uint16(number),nilptr,0,&got)
end
-- Keep the hub's slot/EP0 alive, then select one child in a second slot. The
-- hub's unused interrupt endpoint is dropped before its ring is recycled.
local function drift_usb_hub_child(d: *USB,hub_port: uint8,speed: uint8,hub_ports: uint8,tt_think: uint8): int32 <cexport,codename 'drift_usb_hub_child'>
  if not ready(d) or d.kind~=5 or d.parent_slot~=0 or hub_port==0 or hub_port>15 or hub_ports==0 or hub_port>hub_ports or speed<1 or speed>3 or tt_think>3 then return -22 end
  if (rd(d,4)&255)<2 then return -95 end
  for i: uint32=2,31 do if d.pending_count[i]~=0 then return -16 end end
  local parent=d.slot
  clear(d,16384,4096); sync(d,d.device_context,d.context_size,2)
  for i: uint32=0,<d.context_size do d.arena.data[16384+d.context_size+i]=d.arena.data[d.device_context+i] end
  local slot=16384+d.context_size
  put(d.arena.data,slot,(get(d.arena.data,slot)&0x07ffffff)|(1<<26)|(1<<27))
  put(d.arena.data,slot+4,(get(d.arena.data,slot+4)&0x00ffffff)|uint32(hub_ports)<<24)
  put(d.arena.data,slot+8,uint32(tt_think)<<16)
  put(d.arena.data,16388,1)
  sync(d,16384,4096,1)
  local result=command(d,d.arena.address+16384,13<<10|parent<<24)
  if result~=0 then return result end
  local drop: uint32=0
  for ep: uint32=2,31 do if d.ring_offset[ep]~=0 then drop=drop|(1_u32<<ep) end end
  put(d.arena.data,16384,drop); put(d.arena.data,16388,1)
  sync(d,16384,4096,1)
  result=command(d,d.arena.address+16384,12<<10|parent<<24)
  if result~=0 then return result end
  for ep: uint32=2,31 do d.ring_offset[ep]=0; d.ring_index[ep]=0; d.ring_cycle[ep]=1; d.pending_count[ep]=0; d.completion[ep]=0 end
  d.hub_speed=d.speed; d.speed=uint32(speed); d.parent_slot=parent; d.parent_port=uint32(hub_port)
  d.route=uint32(hub_port); d.slot=0; d.config_index=0; d.device_context=221184; d.ring_offset[1]=225280
  d.ring_index[1]=0; d.ring_cycle[1]=1
  clear(d,221184,8192); sync(d,221184,8192,1)
  return enumerate(d)
end
