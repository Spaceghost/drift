-- USB HID boot keyboard report decoder. SPDX-License-Identifier: MIT
-- The host must bind an unnumbered, eight-byte boot-protocol report stream.
-- This is a stateful protocol driver, not a general HID descriptor parser.
local asm = require 'drift.asm'
require 'C.arg'
local b = asm.new(32, asm.XFER | asm.EMIT, asm.STREAM)

-- r0/r1: completion status/length; r2: zero; r3: eight; r4: previous base.
-- r5: modifiers; r6: usage/changed modifiers; r7/r15: scratch; r8/r9: indices.
-- r10/r11: source/other key-array bases; r12: down; r13: six; r14: one.
b:lit(2, 0)
b:lit(3, 8)
b:lit(4, 16)
b:lit(13, 6)
b:lit(14, 1)
b:mark('read')
b:ins(asm.IO, 2, 2, 2, 3)
b:branch(asm.JNE, 0, 2, 'done')
b:branch(asm.JNE, 1, 3, 'short')

-- A rollover/error array cannot describe transitions. Keep the last good
-- report intact and wait for a usable one, even if modifiers changed.
b:lit(8, 2)
b:mark('validate')
b:ins(asm.LD8, 6, 8, 0, 0)
b:branch(asm.JEQ, 6, 2, 'valid_next')
b:lit(7, 4)
b:branch(asm.JLT, 6, 7, 'read')
b:mark('valid_next')
b:ins(asm.ADD, 8, 8, 14, 0)
b:branch(asm.JLT, 8, 3, 'validate')

-- Modifiers are usages E0..E7. Every event carries the new modifier byte.
b:ins(asm.LD8, 5, 2, 0, 0)
b:ins(asm.LD8, 6, 4, 0, 0)
b:ins(asm.XOR, 6, 5, 6, 0)
b:lit(8, 0)
b:mark('modifier')
b:ins(asm.SHR, 7, 6, 8, 0)
b:ins(asm.AND, 7, 7, 14, 0)
b:branch(asm.JEQ, 7, 2, 'modifier_next')
b:lit(7, 224)
b:ins(asm.ADD, 7, 7, 8, 0)
b:ins(asm.SHR, 9, 5, 8, 0)
b:ins(asm.AND, 9, 9, 14, 0)
b:ins(asm.EVENT, 7, 9, 5, 1)
b:branch(asm.JNE, 0, 2, 'done')
b:mark('modifier_next')
b:ins(asm.ADD, 8, 8, 14, 0)
b:branch(asm.JLT, 8, 3, 'modifier')

-- The same set-difference loop handles releases, then presses, preserving
-- slot order. Prior-slot checks suppress duplicates in malformed arrays.
b:lit(10, 18)
b:lit(11, 2)
b:lit(12, 0)
b:lit(8, 0)
b:mark('key')
b:ins(asm.ADD, 15, 10, 8, 0)
b:ins(asm.LD8, 6, 15, 0, 0)
b:branch(asm.JEQ, 6, 2, 'key_next')
b:lit(9, 0)
b:mark('duplicate')
b:branch(asm.JEQ, 9, 8, 'search')
b:ins(asm.ADD, 15, 10, 9, 0)
b:ins(asm.LD8, 7, 15, 0, 0)
b:branch(asm.JEQ, 6, 7, 'key_next')
b:ins(asm.ADD, 9, 9, 14, 0)
b:branch(asm.JMP, 0, 0, 'duplicate')
b:mark('search')
b:lit(9, 0)
b:mark('member')
b:ins(asm.ADD, 15, 11, 9, 0)
b:ins(asm.LD8, 7, 15, 0, 0)
b:branch(asm.JEQ, 6, 7, 'key_next')
b:ins(asm.ADD, 9, 9, 14, 0)
b:branch(asm.JLT, 9, 13, 'member')
b:ins(asm.EVENT, 6, 12, 5, 1)
b:branch(asm.JNE, 0, 2, 'done')
b:mark('key_next')
b:ins(asm.ADD, 8, 8, 14, 0)
b:branch(asm.JLT, 8, 13, 'key')
b:branch(asm.JNE, 12, 2, 'remember')
b:lit(10, 2)
b:lit(11, 18)
b:lit(12, 1)
b:lit(8, 0)
b:branch(asm.JMP, 0, 0, 'key')

b:mark('remember')
b:lit(8, 0)
b:mark('copy')
b:ins(asm.LD8, 6, 8, 0, 0)
b:ins(asm.ST8, 6, 8, 0, 16)
b:ins(asm.ADD, 8, 8, 14, 0)
b:branch(asm.JLT, 8, 3, 'copy')
b:branch(asm.JMP, 0, 0, 'read')
b:mark('short')
b:lit(0, 1)
b:mark('done')
b:ins(asm.HALT, 0, 0, 0, 0)

if C.argc ~= 2 then error('usage: keyboard OUTPUT.drv') end
b:write(C.argv[1])
