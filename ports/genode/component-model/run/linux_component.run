build { core init lib/ld timer test/linux_component }
create_boot_directory
install_config {
<config>
 <parent-provides><service name="LOG"/><service name="PD"/><service name="CPU"/><service name="ROM"/></parent-provides>
 <default-route><any-service><parent/><any-child/></any-service></default-route>
 <default caps="100"/>
 <start name="timer"><resource name="RAM" quantum="1M"/><provides><service name="Timer"/></provides></start>
 <start name="test-linux-component"><resource name="RAM" quantum="4M"/></start>
</config>
}
build_boot_image [build_artifacts]
